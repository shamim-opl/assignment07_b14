# Public site URL (use your Vercel URL in production)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Random secret, 32+ chars (openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# Postgres connection string (Neon / Supabase / any). If empty, a local SQLite file is used (dev only).
DATABASE_URL=

# Social login (optional but needed for the Google / GitHub buttons)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
